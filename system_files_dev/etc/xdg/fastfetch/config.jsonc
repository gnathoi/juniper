{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/juniper/logo.txt",
    "color": { "1": "green", "2": "blue" },
    "padding": { "right": 2 }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    { "type": "cpu", "temp": true },
    "memory",
    "swap",
    { "type": "disk", "folders": "/var" },
    "localip"
  ]
}
