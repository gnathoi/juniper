# Juniper's default CLI tools, installed with Homebrew at first login (juniper-brew-tools.service)
# and kept current by brew-upgrade.timer. Add your own with `brew install`; re-run this file
# with `ujust brew-tools`. An image update that changes this file installs the new tools at the
# next login. /etc/profile.d/juniper-shell.sh hooks the shell ones in (`ujust toggle-shell`).
brew "zellij"
brew "neovim"
brew "btop"
brew "ripgrep"
brew "fzf"
# Shell: history search (Ctrl-R), prompt, directory jumping (z), completions
brew "atuin"
brew "bash-preexec"
brew "starship"
brew "zoxide"
brew "carapace"
# Nicer ls, cat, find, git diffs, tldr pages and git TUI; YAML/TOML queries; disk usage
brew "eza"
brew "bat"
brew "fd"
brew "git-delta"
brew "tealdeer"
brew "lazygit"
brew "yq"
brew "dysk"
brew "ncdu"
