#!/usr/bin/env bash
# ExecCondition of juniper-reboot.service on the desktop: exit 0 lets the weekly reboot
# window reboot into a staged update; exit 1 skips this window while someone is using the
# desktop (a user-class wayland session, so never the greeter's, that's active and not idle;
# swayidle sets the idle hint after 30 min). Never longer than JUNIPER_DEFER_CAP_DAYS after the first deferral.
# Every error path fails toward rebooting: updates must never be blocked indefinitely.
state=${JUNIPER_STATE_DIR:-/var/lib/juniper}
now=${JUNIPER_NOW:-$(date +%s)}
days=${JUNIPER_DEFER_CAP_DAYS:-7}
[[ $days =~ ^[0-9]+$ ]] || days=7
cap=$((days * 86400))
since_f=$state/reboot-deferred-since
notified_f=$state/reboot-notified

allow() {
  rm -f "$since_f" "$notified_f"
  [[ -z ${1:-} ]] || echo "$1"
  exit 0
}

[[ $("${JUNIPER_BOOTC_STATUS:-/usr/libexec/juniper/bootc-status}" 2>/dev/null | jq '.status.staged != null' 2>/dev/null) == true ]] ||
  allow ""

# A held update (it failed its health check twice) won't be applied: no deferral and no
# "Update ready" notice. The window's apply-update then declines it. Any error counts as not held.
"${JUNIPER_APPLY_UPDATE:-/usr/libexec/juniper/apply-update}" --held >/dev/null 2>&1 &&
  allow "Staged update is held (failed its health check twice): nothing to defer."

in_use=false
for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
  [[ $(loginctl show-session "$s" -p Class --value 2>/dev/null) == user ]] || continue
  [[ $(loginctl show-session "$s" -p Type --value 2>/dev/null) == wayland ]] || continue
  [[ $(loginctl show-session "$s" -p Active --value 2>/dev/null) == yes ]] || continue
  [[ $(loginctl show-session "$s" -p IdleHint --value 2>/dev/null) == no ]] && in_use=true
done
$in_use || allow ""

if [[ -e $since_f ]]; then
  since=$(head -c 32 "$since_f" 2>/dev/null || true)
  # A garbled or future marker means we can't trust the cap math: reboot.
  [[ $since =~ ^[0-9]+$ ]] || allow "Deferral marker unreadable: rebooting."
  since=$((10#$since))
  ((since <= now)) || allow "Deferral marker unreadable: rebooting."
else
  mkdir -p "$state" || allow "Cannot record the deferral: rebooting."
  echo "$now" >"$since_f" || allow "Cannot record the deferral: rebooting."
  since=$now
fi
if ((now - since >= cap)); then
  allow "Desktop in use, but the update has waited $days days: rebooting."
fi

echo "Desktop in use: not rebooting for the staged update this window."
# Best-effort notice for uid 1000 (the desktop's user): when the deferral starts, then at most
# once a day (the hourly retry runs this too). Never changes the exit status.
last=$(head -c 32 "$notified_f" 2>/dev/null || true)
[[ $last =~ ^[0-9]+$ ]] || last=0
last=$((10#$last))
if ((now - last >= 86400 || last > now)); then
  deadline=$(date -d "@$((since + cap))" '+%a %-d %b %H:%M' 2>/dev/null || echo "within $days days")
  bus=${JUNIPER_USER_BUS:-/run/user/1000/bus}
  if user=$(getent passwd 1000 2>/dev/null | cut -d: -f1) && [[ -n $user && -S $bus ]] &&
    runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" notify-send "Update ready" \
      "Reboot when convenient (ujust update). Otherwise it reboots once the desktop is idle, or at the latest around $deadline."; then
    echo "$now" >"$notified_f" 2>/dev/null || true
  fi
fi
exit 1
