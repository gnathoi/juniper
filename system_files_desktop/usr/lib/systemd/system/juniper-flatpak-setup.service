[Unit]
Description=Install Firefox and the Bazaar app store from Flathub (first boot)
# Started by juniper-flatpak-setup.timer, never as part of the boot transaction: a slow or
# offline download must not hold up multi-user.target (cloud-final and the secret scrub).
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/juniper/flatpak-setup.done

[Service]
Type=oneshot
ExecStart=/usr/libexec/juniper/flatpak-setup
TimeoutStartSec=60min
# Until it succeeds: every 30 minutes, and again on the next boot.
Restart=on-failure
RestartSec=30min
