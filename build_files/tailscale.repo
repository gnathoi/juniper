# Juniper's copy (build.sh installs it), not pkgs.tailscale.com's: the key is pinned in
# build_files/keys/ instead of fetched over HTTPS at every build.
[tailscale-stable]
name=Tailscale stable
baseurl=https://pkgs.tailscale.com/stable/rhel/10/$basearch
enabled=1
type=rpm
repo_gpgcheck=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-tailscale
