# Example appliance built on Juniper Minimal: one extra package and one quadlet service.
# Build: podman build --platform linux/arm64 -t ghcr.io/you/sensor-box:latest examples/appliance
# hadolint ignore=DL3007
FROM ghcr.io/gnathoi/juniper-minimal:latest

# hadolint ignore=DL3041
RUN dnf -y install i2c-tools && dnf clean all

# Quadlets shipped in the image live in /usr/share/containers/systemd (immutable, updated
# with the image); ones you add on a device go in /etc/containers/systemd.
COPY sensor.container /usr/share/containers/systemd/sensor.container
# Readiness hook: after an update, the new image is kept only once the sensor stores samples.
COPY health.d/50-sensor-sample /usr/lib/juniper/health.d/50-sensor-sample
# To require your cosign signature on images under your namespace (see README.md):
# ship an image drop-in and its key under /usr (never `RUN trust-images`, which bakes /etc state).
#   COPY cosign.pub /usr/lib/juniper/trusted-images.d/keys/you.pub
#   COPY you.json /usr/lib/juniper/trusted-images.d/you.json
#   COPY you.yaml /etc/containers/registries.d/you.yaml

RUN bootc container lint
