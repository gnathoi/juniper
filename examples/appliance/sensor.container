[Unit]
Description=Example sensor: log the SoC temperature every minute

[Container]
# Pinned by digest: the device runs exactly this image until you change the line, whatever
# happens to the tag or the registry. To bump it, look up the new digest, check it, edit here and
# ship it with your next image:
#   skopeo inspect --raw docker://docker.io/library/alpine:3.20 | sha256sum
Image=docker.io/library/alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
# For a fleet, sign your own image and let it auto-update instead: on each device run
# `ujust trust-images ghcr.io/you ~/cosign.pub` (or ship a drop-in in your image, see README.md), then
#   Image=ghcr.io/you/sensor:latest
#   AutoUpdate=registry
# podman auto-update then only pulls a new image that carries your signature.
Exec=sh -c 'while true; do cat /sys/class/thermal/thermal_zone0/temp; sleep 60; done'
Volume=/sys/class/thermal:/sys/class/thermal:ro

[Install]
WantedBy=multi-user.target
