#!/usr/bin/env bash
# Every boot (juniper-healthcheck.service): if the system is healthy, make the booted
# deployment the firmware default; if an update booted via tryboot is unhealthy, reboot
# so the firmware falls back to the previous deployment.
# ponytail: a bad update is retried at each reboot window until a fixed image ships; add a
# known-bad digest list if that ever matters.
set -euo pipefail

state_dir=${JUNIPER_STATE_DIR:-/var/lib/juniper}
tries=${JUNIPER_HEALTH_TRIES:-20}
interval=${JUNIPER_HEALTH_INTERVAL:-15}
tryboot_flag=${JUNIPER_TRYBOOT_FLAG:-/proc/device-tree/chosen/bootloader/tryboot}
health_d=${JUNIPER_HEALTH_D:-/usr/lib/juniper/health.d}
hook_timeout=${JUNIPER_HEALTH_HOOK_TIMEOUT:-15}
hook_kill=${JUNIPER_HEALTH_HOOK_KILL:-5}
# Stop retrying after this many seconds, so the tryboot fallback below always runs well before
# juniper-healthcheck.service's TimeoutStartSec=10min kills the check (which would skip it).
deadline=${JUNIPER_HEALTH_DEADLINE:-420}
# Every probe is bounded the same way, so a wedged tailscaled, netlink or D-Bus can't stall a
# try: it is killed (SIGKILL if it ignores SIGTERM) and the try counts as unhealthy.
probe_timeout=${JUNIPER_HEALTH_PROBE_TIMEOUT:-10}
probe_kill=${JUNIPER_HEALTH_PROBE_KILL:-5}

probe() { timeout -k "$probe_kill" "$probe_timeout" "$@"; }

healthy() {
  [[ -n $(probe ip route show default) || -n $(probe ip -6 route show default) ]] || return 1
  # Once locked, SSH over the tailnet is the only way in: Tailscale must be up, and either
  # Tailscale SSH on or sshd running (`ujust tailscale-ssh off` falls back to sshd).
  if [[ -e $state_dir/locked ]]; then
    local ts
    ts=$(probe tailscale status --json 2>/dev/null) || return 1
    [[ $(jq -r '.BackendState // empty' <<<"$ts" 2>/dev/null) == Running ]] || return 1
    [[ $(probe tailscale debug prefs 2>/dev/null | jq -r '.RunSSH // false') == true ]] ||
      [[ $(probe systemctl is-active sshd.service 2>/dev/null) == active ]] || return 1
  fi
  # Image-specific checks (juniper-desktop: greetd must be running). None on headless images.
  # Each is bounded (SIGKILL if it ignores SIGTERM), so a hung hook can't stall a try.
  local hook
  for hook in "$health_d"/*; do
    [[ -x $hook ]] || continue
    timeout -k "$hook_kill" "$hook_timeout" "$hook" || {
      echo "health hook ${hook##*/} failed" >&2
      return 1
    }
  done
}

in_tryboot() {
  # Big-endian u32 set by the Pi bootloader when it booted tryboot.txt. Fail closed: only an
  # exact 1 counts; 0, empty, longer or missing means a normal boot (never reboot-loop).
  [[ -r $tryboot_flag ]] && [[ $(od -An -tu4 --endian=big -N4 "$tryboot_flag" | tr -d ' ') == 1 ]]
}

for ((i = 0; i < tries && SECONDS < deadline; i++)); do
  if healthy; then
    rpi-bootc-bootloader sync
    exit 0
  fi
  ((SECONDS + interval < deadline)) || break
  sleep "$interval"
done

echo "Health check failed: no default route, (locked) Tailscale or SSH over it down, or an image health hook failed." >&2
if in_tryboot; then
  echo "Unhealthy update under tryboot; rebooting into the previous deployment." >&2
  systemctl reboot
fi
exit 1
