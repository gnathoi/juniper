#!/usr/bin/env bash
# Login banner: fastfetch, then Juniper status. Shown by /etc/profile.d/juniper-motd.sh.
set -uo pipefail

state_dir=${JUNIPER_STATE_DIR:-/var/lib/juniper}
# shellcheck source=/dev/null
. /usr/lib/os-release

row() { printf '  \e[1;32m%-10s\e[0m %s\n' "$1" "$2"; }

# The booted image's reference (what updates pull: ghcr.io/you/image:tag), from its deployment's
# world-readable origin file; the kernel's ostree= path leads to that deployment. Prints
# nothing if it can't tell.
image_ref() {
  local sysroot=${JUNIPER_OSTREE_PATH:-/sysroot} o d ref
  o=$(tr ' ' '\n' <"${JUNIPER_CMDLINE:-/proc/cmdline}" 2>/dev/null | sed -n 's/^ostree=//p' | head -n1)
  [[ -n $o ]] || return 0
  d=$(readlink -f "$sysroot$o" 2>/dev/null) || return 0
  ref=$(sed -n 's/^container-image-reference=//p' "$d.origin" 2>/dev/null | head -n1)
  # Drop the transport: ostree-unverified-registry:IMG, ostree-remote-image:REMOTE:docker://IMG, ...
  case $ref in
    ostree-remote-*:*:*) ref=${ref#*:} ref=${ref#*:} ;;
    ostree-*:*) ref=${ref#*:} ;;
  esac
  ref=${ref#docker://}
  ref=${ref#registry:}
  printf '%s' "$ref" | tr -cd '[:print:]'
}

if ip=$(tailscale ip -4 2>/dev/null) && [[ -n $ip ]]; then
  if [[ -e $state_dir/locked ]]; then fw="firewall: Tailscale only"; else fw="firewall: LAN open"; fi
  ts="${ip%%$'\n'*} ($fw)"
else
  ts="not connected - run: ujust tailscale-up"
fi
# An interactive login makes an expiring node; once locked down, expiry cuts off access.
exp=$(tailscale status --json 2>/dev/null | jq -r '.Self.KeyExpiry // empty' 2>/dev/null)
if [[ -n $exp ]]; then
  ts+=" - key expires ${exp%%T*}; disable key expiry for this machine in the Tailscale admin console"
fi

if [[ $ts == "not connected"* && -e $state_dir/tailscale-join-gave-up ]]; then
  ts="not joined: $(cat "$state_dir/tailscale-join-gave-up"); the key was deleted. Run: ujust tailscale-up"
fi

if systemctl -q is-failed juniper-update.service; then
  upd="update failed - see: journalctl -u juniper-update"
elif [[ -s $state_dir/update-held ]]; then
  # Written by apply-update: the staged image failed its health check before (quarantined).
  upd=$(head -n1 "$state_dir/update-held" | tr -cd '[:print:]')
elif [[ -e /run/ostree/staged-deployment ]]; then
  when=$(systemctl show juniper-reboot.timer -P NextElapseUSecRealtime 2>/dev/null)
  [[ $when == n/a ]] && when=
  upd="staged, reboots ${when:-manually (ujust update)}"
else
  upd="up to date"
fi

# fastfetch ships only in the full image.
if command -v fastfetch >/dev/null; then fastfetch; fi
ref=$(image_ref)
if [[ -n $ref ]]; then
  row Image "$ref${IMAGE_VERSION:+ ($IMAGE_VERSION)}"
else
  row Image "${PRETTY_NAME}"
fi
row Tailscale "$ts"
row Update "$upd"
# Only after lockdown does the old unscoped `lan-ssh on` matter; before it SSH is open anyway.
# Root writes this file (juniper-lan-ssh-status.service, lan-ssh on|off): we can't ask firewalld.
legacy_file=${JUNIPER_RUN_DIR:-/run/juniper}/lan-ssh-legacy
if [[ -e $state_dir/locked && -s $legacy_file ]]; then
  row Warning "$(cat "$legacy_file")"
fi
# Written by encryption-status. A card that never asked for encryption says nothing here
# (pi-status has a quiet line); a failed request or an unsealed recovery key is a warning.
enc=$state_dir/encryption
if [[ -r $enc ]]; then
  ev() { sed -n "s/^$1=//p" "$enc" | head -1 | tr -cd '[:print:]'; }
  if [[ $(ev state) == encrypted ]]; then
    rec=$(ev recovery)
    if [[ $rec != sealed:* ]]; then
      row Warning "Storage recovery key not sealed (${rec:-unknown}): only this Pi can unlock this card."
    fi
  elif [[ $(ev state) == unknown ]]; then
    printf '  \e[1;32m%-10s\e[0m \e[1;31m%s\e[0m\n' Warning \
      "Storage encryption status unknown ($(ev friendly)): it may not be encrypted. $(ev advice)"
  elif [[ $(ev requested) == yes ]]; then
    printf '  \e[1;32m%-10s\e[0m \e[1;31m%s\e[0m\n' Warning \
      "Storage NOT ENCRYPTED ($(ev friendly)): anyone holding this card can read its secrets. $(ev advice)"
  fi
fi
# Written by update-stage when the disk was too full to stage an update.
if [[ -s $state_dir/update-skipped-space ]]; then
  row Warning "$(head -n1 "$state_dir/update-skipped-space" | tr -cd '[:print:]')"
fi
# Under 10% or 1 GiB free where the ostree repo lives (as update-stage checks); df needs no root.
fs=${JUNIPER_OSTREE_PATH:-/sysroot}
[[ -d $fs ]] || fs=/
read -r total avail < <(df -Pm "$fs" 2>/dev/null | awk 'NR == 2 {print $2, $4}') || true
if [[ ${total:-0} =~ ^[0-9]+$ && ${avail:-} =~ ^[0-9]+$ ]] && ((total > 0 && (avail * 10 < total || avail < 1024))); then
  row Warning "Low disk space: ${avail} MiB free of ${total} MiB on ${fs}; free some or move data to a USB disk"
fi
# Measurement timestamps and TLS can't be trusted before the clock syncs (no RTC on a Pi).
if [[ $(timeout 5 timedatectl show -p NTPSynchronized --value 2>/dev/null) == no ]]; then
  row Warning "Clock not synchronised (NTP)"
fi
row Tip "$(cat /usr/share/juniper/tips*.txt 2>/dev/null | shuf -n1)"
printf '\n  ujust for commands · ujust toggle-motd to hide this\n\n'
