#!/usr/bin/env bash
# Show, set or disable the automatic update reboot window (default: Tue 04:00 local time).
#   update-schedule               show the update and reboot timers
#   update-schedule DAY HH:MM     weekly window; DAY is mon..sun or daily
#   update-schedule HH:MM         change the time, keep the current day
#   update-schedule off           never reboot automatically (updates still download)
# A random delay of up to 90 minutes is added to the window start.
set -euo pipefail

dropin_dir=${JUNIPER_DROPIN_DIR:-/etc/systemd/system/juniper-reboot.timer.d}
conf=$dropin_dir/schedule.conf
time_re='^([01][0-9]|2[0-3]):[0-5][0-9]$'

usage() {
  echo "usage: ujust update-schedule [off | [DAY] HH:MM]   (DAY: mon..sun or daily; 24-hour local time)" >&2
  exit 2
}

set_window() { # DAY (Mon..Sun or daily) HH:MM
  local cal="*-*-* $2:00" tz
  [[ $1 == daily ]] || cal="$1 $cal"
  mkdir -p "$dropin_dir"
  printf '[Timer]\nOnCalendar=\nOnCalendar=%s\n' "$cal" >"$conf"
  systemctl daemon-reload
  systemctl enable --now juniper-reboot.timer
  tz=$(timedatectl show -p Timezone --value 2>/dev/null || echo UTC)
  echo "Update reboots start ${1/daily/every day} at $2 ${tz:-UTC} time, plus up to 90 minutes of random delay."
}

# Weekday token of the existing drop-in's last OnCalendar line; daily if none, Tue if no drop-in.
current_day() {
  local last
  [[ -f $conf ]] || {
    echo Tue
    return
  }
  last=$(grep '^OnCalendar=.' "$conf" | tail -n1 || true)
  [[ $last =~ ^OnCalendar=(Mon|Tue|Wed|Thu|Fri|Sat|Sun)\  ]] && echo "${BASH_REMATCH[1]}" || echo daily
}

day_token() { # mon -> Mon, daily -> daily; fails on anything else
  local d=${1,,}
  case $d in
    mon | tue | wed | thu | fri | sat | sun) echo "${d^}" ;;
    daily) echo daily ;;
    *) return 1 ;;
  esac
}

case $# in
  0) systemctl list-timers juniper-update.timer juniper-reboot.timer ;;
  1)
    if [[ $1 == off ]]; then
      systemctl disable --now juniper-reboot.timer
      echo "Automatic update reboots are off. Apply updates with: ujust update"
    elif [[ $1 =~ $time_re ]]; then
      set_window "$(current_day)" "$1"
    else
      usage
    fi
    ;;
  2)
    day=$(day_token "$1") && [[ $2 =~ $time_re ]] || usage
    set_window "$day" "$2"
    ;;
  *) usage ;;
esac
