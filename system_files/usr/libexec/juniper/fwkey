#!/usr/bin/env bash
# The Pi's OTP device key through the firmware (rpi-fw-crypto, key id 1), for the LUKS root
# (issue #50). Never reads the raw key; generates one only when the slot is blank; never
# writes key usage. Secrets go to stdout only; no temporary files.
#
#   fwkey probe          ok | not-set | unavailable:<detail>                   (exit 0)
#   fwkey ensure         ok | generated | unavailable:<detail>    (exit 0 if usable, else 1)
#   fwkey card-id DISK   mmc:<cid> | nvme:<serial> | usb:<vid>:<pid>:<serial> | board:
#   fwkey derive DISK    the passphrase: exactly 64 lowercase hex bytes, no newline
#   fwkey lock           locked | unavailable                    (best-effort, always exit 0)
#
# Firmware gate, before any rpi-fw-crypto call (hardware finding, #50): firmware older than
# pieeprom-2026-01-21 locks up the VideoCore mailbox on HMAC with a blank or invalid key, and
# the next mailbox user then sleeps uninterruptibly (D state) for up to an hour; timeout(1)
# can't kill it. So:
#   - Pi 5 (BCM2712) only, with a running bootloader build >= 1769002727 (2026-01-21), read
#     from the device tree (no mailbox): else unavailable:firmware-too-old. Pi 4 (BCM2711) is
#     served by start4.elf and is unverified: unavailable:pi4-unverified.
#   - Key presence is `pubkey`, never hmac or get-key-status (whose DEVICE bit says nothing
#     about key material): exit 250 (KEY_NOT_SET) is the only answer that allows genkey.
#   - Every call has a deadline. One that overruns is left behind (it can't be killed), the
#     wedged marker is written, and no further mailbox call is made this boot. Recovery is a
#     reboot: the hardware watchdog or a forced one (a plain reboot may block on the wedged
#     mailbox; `echo b >/proc/sysrq-trigger` doesn't). Callers fail open.
#   - Firmware < 2026-06-17 with status bit 8 (the global lock, set by an old image's config.txt
#     lock_device_private_key=1) also blocks genkey: unavailable:key-locked-by-config, no genkey.
#   - Unknown answers mean "don't know", never "ok", "not-set" or "locked".
set -euo pipefail
sysfs=${JUNIPER_SYSFS:-/sys}
vcio=${JUNIPER_VCIO:-/dev/vcio}
fw=${RPI_FW_CRYPTO:-rpi-fw-crypto}
dt=${JUNIPER_DT:-/proc/device-tree}
wedged=${JUNIPER_FWKEY_WEDGED:-/run/juniper/fwkey-wedged}
deadline=${JUNIPER_FWKEY_DEADLINE:-10}
# A bad value would make `read -t` fail at once and the `wait` below block: fall back.
[[ $deadline =~ ^[0-9]{1,3}(\.[0-9]+)?$ && ! $deadline =~ ^0+(\.0*)?$ ]] || deadline=10
label='juniper.luks.root.v1'
# Pi 5 bootloader BUILD_TIMESTAMPs (strings in the rpi-eeprom blobs).
min_build=1769002727  # pieeprom-2026-01-21: "Fix bad hmac arguments lock-up"
lock_build=1781654813 # pieeprom-2026-06-17: fine-grained locking (HMAC_LOCKED is bit 11)

# first_line: the first line of $1. No `| head -1` (nor a quitting sed) on a pipe: the writer
# can die of SIGPIPE under pipefail.
first_line() { printf '%s' "${1%%$'\n'*}"; }
fw_error() { first_line "$(printf '%s\n' "$1" | sed -n 's/^Last crypto error: \([0-9]*\).*/\1/p')"; }

# --- the gate ---
build=0
why=
# gate: 0 if rpi-fw-crypto may be called; else 1 with $why set. Reads files only.
gate() {
  local c ts f
  if [[ -e $wedged ]]; then
    why=firmware-wedged
    return 1
  fi
  if [[ ! -e $vcio ]]; then
    why="no $vcio"
    return 1
  fi
  c=$(tr '\0' ' ' 2>/dev/null <"$dt/compatible") || c=
  case " $c " in
    *" brcm,bcm2712"*) ;;
    *" brcm,bcm2711"*)
      why=pi4-unverified
      return 1
      ;;
    *)
      why=unsupported-board
      return 1
      ;;
  esac
  # Big-endian u32, read like rpi-eeprom-update / the healthcheck's tryboot flag. Exactly 4
  # bytes: GNU od zero-pads a short word and exits 0 (\xff\xff would read as 4294901760).
  f=$dt/chosen/bootloader/build-timestamp
  ts=
  if [[ -r $f && $(wc -c 2>/dev/null <"$f") == 4 ]]; then
    ts=$(od -An -tu4 --endian=big -N4 "$f" 2>/dev/null | tr -d ' \n') || ts=
  fi
  if [[ ! $ts =~ ^[0-9]{1,10}$ ]] || ((10#$ts < min_build)); then
    why=firmware-too-old
    return 1
  fi
  build=$((10#$ts))
}

# --- bounded calls ---
fw_out=
fw_rc=0
no_input() { :; }
msg_id=
derive_input() { printf '%s\0%s' "$label" "$msg_id"; }

# fw_call INPUT_FN ARGS...: rpi-fw-crypto ARGS, fed by INPUT_FN, as a background child that
# holds none of our stdio (so a stuck child can't hold up a caller's $(...)). Sets fw_out
# (stdout and stderr) and fw_rc. Returns 1, after writing the wedged marker, if it overran.
fw_call() {
  local input=$1 fd pid rc=0
  shift
  fw_out=
  fw_rc=0
  exec {fd}< <(
    exec </dev/null 2>&1
    "$input" | "$fw" "$@"
  )
  pid=$!
  IFS= read -r -d '' -t "$deadline" -u "$fd" fw_out || rc=$?
  if ((rc == 1)); then # EOF: the child is done
    exec {fd}<&-
    wait "$pid" || fw_rc=$?
    return 0
  fi
  if ((rc <= 128)); then
    # A NUL (rc 0) or a read error: not an answer, and the child may still run. Don't wait.
    exec {fd}<&-
    fw_out=
    fw_rc=255
    return 0
  fi
  exec {fd}<&-
  fw_out=
  mkdir -p "${wedged%/*}" 2>/dev/null || true
  : >"$wedged" 2>/dev/null || true
  echo "fwkey: rpi-fw-crypto $1 did not answer in ${deadline}s; firmware mailbox wedged until reboot" >&2
  why=firmware-wedged
  return 1
}

hmac_hex() { fw_call "$1" hmac --in /dev/stdin --key-id 1 --outform hex; }

# config_locked: 0 if the key status has bit 8 set on firmware older than lock_build. There bit
# 8 is the global lock that config.txt's lock_device_private_key=1 sets, and it also blocks
# genkey (error 4, hardware finding): this boot can't provision a key. On newer firmware bit 8
# is READ_LOCKED only and genkey still works. Reads status only; false on any doubt.
config_locked() {
  local hex
  ((build < lock_build)) || return 1
  fw_call no_input get-key-status 1 && ((fw_rc == 0)) || return 1
  hex=$(first_line "$(printf '%s\n' "$fw_out" | sed -n 's/^Key 1 status: 0x\([0-9a-fA-F]\{1,8\}\).*/\1/p')")
  [[ -n $hex ]] && ((16#$hex & 0x100))
}

probe() {
  local err rc
  gate || {
    echo "unavailable:$why"
    return
  }
  fw_call no_input pubkey --key-id 1 --out /dev/null || {
    echo "unavailable:$why"
    return
  }
  err=$(fw_error "$fw_out")
  rc=$fw_rc
  case $rc in
    0) echo ok ;;
    250) echo not-set ;;
    249) echo unavailable:invalid-key ;;
    *)
      if [[ $err == 4 ]] && config_locked; then
        echo unavailable:key-locked-by-config
        return
      fi
      echo "unavailable:firmware error ${err:-none} (exit $rc)"
      ;;
  esac
}

# genkey is an OTP write: only when pubkey said KEY_NOT_SET, never on any other answer.
ensure() {
  local state err
  state=$(probe)
  case $state in
    ok)
      echo ok
      return
      ;;
    not-set)
      gate && config_locked && {
        echo "unavailable:key-locked-by-config"
        return 1
      }
      ;;
    unavailable:*)
      echo "$state"
      return 1
      ;;
    *)
      echo "unavailable:unexpected probe answer"
      return 1
      ;;
  esac
  fw_call no_input genkey --key-id 1 --alg ec || {
    echo "unavailable:$why"
    return 1
  }
  if ((fw_rc != 0)); then
    err=$(fw_error "$fw_out")
    echo "unavailable:genkey failed (firmware error ${err:-none})"
    return 1
  fi
  state=$(probe)
  if [[ $state == ok ]]; then
    echo generated
    return
  fi
  echo "unavailable:after genkey the probe says ${state#unavailable:}"
  return 1
}

# read_id FILE: the attribute with all whitespace removed; fails if missing or empty.
read_id() {
  local v
  [[ -r $1 ]] || return 1
  v=$(tr -d '[:space:]' <"$1") || return 1
  [[ -n $v ]] || return 1
  printf '%s' "$v"
}

card_id() {
  [[ $1 =~ ^[A-Za-z0-9]+$ ]] || return 1
  local d=$sysfs/block/$1 v root p vid pid
  [[ -e $d ]] || return 1
  if v=$(read_id "$d/device/cid"); then
    printf 'mmc:%s\n' "$v"
    return
  fi
  if [[ $1 == nvme* ]] && v=$(read_id "$d/device/serial"); then
    printf 'nvme:%s\n' "$v"
    return
  fi
  # The USB device above the disk: the nearest ancestor with idVendor, inside sysfs.
  root=$(readlink -f "$sysfs" 2>/dev/null || true)
  p=$(readlink -f "$d/device" 2>/dev/null || true)
  while [[ -n $root && $p == "$root"/* && ! -r $p/idVendor ]]; do p=${p%/*}; done
  if [[ -n $root && $p == "$root"/* ]] && vid=$(read_id "$p/idVendor") &&
    pid=$(read_id "$p/idProduct") && v=$(read_id "$p/serial"); then
    printf 'usb:%s:%s:%s\n' "$vid" "$pid" "$v"
    return
  fi
  # Ruling 1: a USB disk with no serial (or with no id we know) binds to the board only.
  printf 'board:\n'
}

derive() {
  msg_id=$(card_id "$1") || return 1
  gate || return 1
  hmac_hex derive_input || return 1
  ((fw_rc == 0)) || return 1
  [[ $fw_out =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s' "$fw_out"
  fw_out=
}

# Ruling 4: best-effort, never an error, and `unavailable` is expected today. The per-operation
# flags only exist from pieeprom-2026-06-17; before that bit 8 was a global LOCKED bit and the
# others are unknown to the firmware, so older firmware isn't asked at all. SIGN stays
# unlocked for Raspberry Pi Connect. `locked` only when the firmware reports HMAC_LOCKED.
lock() {
  local hex
  if gate && ((build >= lock_build)) &&
    fw_call no_input set-key-status 1 READ_LOCKED GEN_LOCKED HMAC_LOCKED USAGE_LOCKED &&
    ((fw_rc == 0)) && fw_call no_input get-key-status 1 && ((fw_rc == 0)); then
    hex=$(first_line "$(printf '%s\n' "$fw_out" | sed -n 's/^Key 1 status: 0x\([0-9a-fA-F]\{1,8\}\).*/\1/p')")
    if [[ -n $hex ]] && ((16#$hex & 0x800)); then
      echo locked
      return 0
    fi
  fi
  echo unavailable
  return 0
}

usage() {
  echo "usage: fwkey probe|ensure|lock|card-id DISK|derive DISK" >&2
  exit 2
}

cmd=${1:-}
case $cmd in
  probe | ensure | lock) (($# == 1)) || usage ;;
  card-id | derive) (($# == 2)) || usage ;;
  *) usage ;;
esac
case $cmd in
  card-id) card_id "$2" ;;
  *) "$cmd" "${@:2}" ;;
esac
