#!/usr/bin/env bash
# One-shot first-boot setup, after cloud-init (juniper-firstboot.service):
# scrub secrets off the unencrypted CIDATA partition and cloud-init's cache, and retire
# cloud-init. (Signature enforcement on updates comes from /etc/containers/policy.json.)
# Safe to re-run: every step is idempotent.
set -euo pipefail

state_dir=${JUNIPER_STATE_DIR:-/var/lib/juniper}
share=${JUNIPER_SHARE:-/usr/share/juniper}
cloud_disabled=${JUNIPER_CLOUD_DISABLED:-/etc/cloud/cloud-init.disabled}
cidata_dir=${JUNIPER_CIDATA_DIR:-}
cloud_dir=${JUNIPER_CLOUD_DIR:-/var/lib/cloud}

scrub_cidata() {
  # The Wi-Fi password and Tailscale key were handed over via CIDATA; cloud-init has
  # already applied them, so put the secret-free template back.
  if [[ -z $cidata_dir ]]; then
    local dev
    dev=$(blkid -L CIDATA)
    cidata_dir=$(mktemp -d)
    mount "$dev" "$cidata_dir"
    trap 'umount "$cidata_dir"; rmdir "$cidata_dir"' EXIT
  fi
  # shred: the FAT partition would otherwise keep the secrets in free clusters.
  if [[ -e $cidata_dir/network-config ]]; then shred -u "$cidata_dir/network-config"; fi
  if [[ -e $cidata_dir/user-data ]]; then shred "$cidata_dir/user-data"; fi
  cp "$share/cidata/user-data" "$cidata_dir/user-data"
  sync
}

purge_cloud_cache() {
  # cloud-init keeps its own copy of user-data (with the Tailscale key) under /var/lib/cloud.
  local f
  for f in "$cloud_dir"/instances/*/user-data.txt* "$cloud_dir"/instances/*/cloud-config.txt \
    "$cloud_dir"/instances/*/obj.pkl; do
    if [[ -e $f ]]; then shred -u "$f"; fi
  done
}

scrub_cidata
purge_cloud_cache
# Last: disabling cloud-init stops cloud-init.target, which is what starts this service on the
# first boot, so anything left undone after it is only retried by juniper-firstboot-retry.
touch "$cloud_disabled"
mkdir -p "$state_dir"
touch "$state_dir/firstboot.done"
