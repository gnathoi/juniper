#!/usr/bin/env bash
# Reboot into a staged update (juniper-reboot.timer, `ujust update`).
# Uses firmware tryboot: the new deployment boots once; juniper-healthcheck makes it the
# default, otherwise the next boot falls back to the current one. A plain reboot would
# keep the old deployment because tryboot.conf sets TRYBOOT=1.
# A staged image whose digest failed its health check before (healthcheck records it in
# bad-digests) is not booted again; a newer image proceeds. The reason is kept in update-held
# for the motd and `ujust pi-status`. To retry it anyway, remove it from bad-digests.
#   apply-update          reboot into the staged update, unless it is quarantined
#   apply-update --check  only refresh update-held (juniper-update.service, after staging)
set -euo pipefail

state_dir=${JUNIPER_STATE_DIR:-/var/lib/juniper}
held=$state_dir/update-held

case ${1:-} in
  "" | --check) ;;
  *)
    echo "usage: apply-update [--check]" >&2
    exit 2
    ;;
esac

status=$(bootc status --json)
if [[ $(jq '.status.staged != null' <<<"$status") != true ]]; then
  rm -f "$held"
  [[ ${1:-} == --check ]] || echo "No staged update; not rebooting."
  exit 0
fi

digest=$(jq -r '.status.staged.image.imageDigest // empty' <<<"$status")
if [[ $digest =~ ^sha256:[0-9a-f]{64}$ ]] && grep -qxF -- "$digest" "$state_dir/bad-digests" 2>/dev/null; then
  msg="update $digest failed its health check; waiting for a newer image"
  echo "$msg"
  mkdir -p "$state_dir"
  echo "$msg" >"$held"
  exit 0
fi
rm -f "$held"
[[ ${1:-} == --check ]] && exit 0
exec rpi-bootc-bootloader tryreboot
