#!/usr/bin/env bash
# `ujust update-unhold`: forget failed-update strikes, so a held image is tried again at the
# next update window (or by `ujust update`). Clears bad-digests and update-held, and says
# which digests it cleared.
set -euo pipefail

state_dir=${JUNIPER_STATE_DIR:-/var/lib/juniper}
list=$state_dir/bad-digests
held=$state_dir/update-held

# Digests with a recorded strike (first column; the file is "DIGEST COUNT BOOT_ID").
cleared=$(awk '$1 ~ /^sha256:[0-9a-f]+$/ {print $1}' "$list" 2>/dev/null || true)

mapfile -t digests <<<"$cleared"
if [[ -z $cleared && ! -e $held ]]; then
  echo "nothing held"
  exit 0
fi
rm -f "$list" "$list.tmp" "$held"
if [[ -n $cleared ]]; then
  echo "Cleared (will be tried again at the next update window):"
  printf '  %s\n' "${digests[@]}"
else
  echo "Cleared the held-update note."
fi
