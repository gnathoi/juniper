[Unit]
Description=Write Juniper status metrics for node_exporter's textfile collector
# A fresh bootc status snapshot each run, taken in install_t (see that unit)
Wants=juniper-bootc-status.service
After=juniper-bootc-status.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/juniper/metrics
TimeoutStartSec=120
Nice=19
IOSchedulingClass=idle
