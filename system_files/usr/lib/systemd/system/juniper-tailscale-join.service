[Unit]
Description=Join the tailnet with the auth key provided at flash time
# cloud-init.service (not cloud-final, which runs after multi-user.target) writes the key.
After=network-online.target tailscaled.service cloud-init.service
Wants=network-online.target tailscaled.service
ConditionPathExists=/etc/tailscale/authkey

[Service]
Type=exec
# The script deletes the key after a successful join, or gives up (and deletes it) when
# Tailscale rejects it or it is over 14 days old. Other failures retry every minute and on boot.
ExecStart=/usr/libexec/juniper/tailscale-join
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
