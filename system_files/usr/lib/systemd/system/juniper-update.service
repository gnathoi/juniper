[Unit]
Description=Download and stage the latest Juniper image
After=network-online.target juniper-healthcheck.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/bootc upgrade --quiet
# Note in update-held (motd, `ujust pi-status`) when the staged image is one that failed its
# health check before; never fails the download.
ExecStartPost=-/usr/libexec/juniper/apply-update --check
