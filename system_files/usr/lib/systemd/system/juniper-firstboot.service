[Unit]
Description=Juniper first-boot setup (scrub CIDATA, retire cloud-init)
After=cloud-final.service
ConditionPathExists=!/var/lib/juniper/firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/libexec/juniper/firstboot
RemainAfterExit=yes

[Install]
# Not multi-user.target: cloud-final runs after it, so that would be an ordering cycle
# and systemd would drop this job. cloud-init.target is only active on first boot anyway.
WantedBy=cloud-init.target
