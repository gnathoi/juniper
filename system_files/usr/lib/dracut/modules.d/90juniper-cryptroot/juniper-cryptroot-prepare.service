[Unit]
Description=Juniper encrypted root: first-boot encryption, resume, recovery sealing
DefaultDependencies=no
# Before udev: on first boot the root filesystem disappears and reappears as LUKS; doing it
# before any device unit exists keeps systemd's root-device handling out of it.
After=systemd-modules-load.service
Before=systemd-udevd.service systemd-udev-trigger.service dracut-pre-udev.service sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
# systemd-udevd-control.socket (sockets.target) already exists here, so libdevmapper would
# take udev for running and wait for it on any dm device cryptsetup creates (e.g. its
# temporary dm-crypt fallback in offline reencryption). udevd is ordered after this unit,
# so that wait never ends. Without udev, libdevmapper creates the /dev/mapper nodes itself.
# unlock runs after udevd and must keep udev sync (dm rules, by-uuid link for sysroot).
Environment=DM_DISABLE_UDEV=1
ExecStartPre=-/usr/sbin/modprobe -a dm_mod dm_crypt
ExecStart=/usr/libexec/juniper/cryptroot prepare
TimeoutStartSec=infinity
StandardOutput=journal+console
StandardError=journal+console
