#!/usr/bin/python3
"""Render a flash config (see examples/flash.yaml) into the CIDATA files a Juniper image reads
on first boot: user-data and, with Wi-Fi, network-config (netplan v2, as Raspberry Pi Imager
writes it; the image's juniper-wifi-import applies it). Both are 0600: they hold secrets.
  render-cidata CONFIG OUTDIR
"""

import base64
import binascii
import os
import re
import sys

import yaml

KEYS = {"image", "hostname", "user", "timezone", "ssh_keys", "tailscale_authkey",
        "tailscale_authkey_file", "wifi", "password", "encrypt", "recovery_key"}
WIFI_KEYS = {"ssid", "password", "country"}
KEY_PREFIXES = ("ssh-", "ecdsa-", "sk-ssh-", "sk-ecdsa-")


def fail(msg):
    sys.exit(f"render-cidata: {msg}")


BECH32 = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"


def bech32_ok(hrp, s):
    """True if s is a valid lowercase bech32 string (BIP 173) with this human-readable part
    and a whole number of bytes (age recipients: hrp "age", 32 bytes)."""
    if not s.startswith(hrp + "1") or any(c not in BECH32 for c in s[len(hrp) + 1:]):
        return False
    data = [BECH32.index(c) for c in s[len(hrp) + 1:]]
    chk = 1
    for v in [ord(c) >> 5 for c in hrp] + [0] + [ord(c) & 31 for c in hrp] + data:
        top, chk = chk >> 25, (chk & 0x1ffffff) << 5 ^ v
        for i, g in enumerate((0x3b6a57b2, 0x26508e6d, 0x1ea119fa, 0x3d4233dd, 0x2a1462b3)):
            chk ^= g if top >> i & 1 else 0
    pad = len(data[:-6]) * 5 % 8
    return chk == 1 and len(data) > 6 and pad < 5 and data[-7] & ((1 << pad) - 1) == 0


def ssh_key(k):
    """Check one OpenSSH public key line: the base64 data decodes and names the same key type,
    ed25519 keys are 32 bytes and RSA keys at least 2048 bits (age, which seals the recovery
    key to them, refuses smaller ones, and so does the image's crypto policy for logins)."""
    k = str(k)
    if "\n" in k or "\r" in k:
        fail("ssh_keys: one key per entry; this one spans several lines")
    parts = k.split(None, 2)
    if len(parts) < 2 or not parts[0].startswith(KEY_PREFIXES):
        fail(f"ssh_keys: not an OpenSSH public key: {k[:20]}...")
    kind, data = parts[:2]
    try:
        blob = base64.b64decode(data, validate=True)
    except (binascii.Error, ValueError):
        blob = b""
    fields = []
    while len(blob) >= 4:
        n = int.from_bytes(blob[:4], "big")
        if n > len(blob) - 4:
            break
        fields.append(blob[4:4 + n])
        blob = blob[4 + n:]
    if blob or not fields or fields[0] != kind.encode():
        fail(f"ssh_keys: the key data of {kind} {data[:12]}... is damaged or isn't a {kind} key "
             "(copy the whole line from the .pub file)")
    if kind == "ssh-ed25519" and (len(fields) != 2 or len(fields[1]) != 32):
        fail(f"ssh_keys: {kind} {data[:12]}... has the wrong length")
    if kind == "ssh-rsa":
        bits = int.from_bytes(fields[2], "big").bit_length() if len(fields) == 3 else 0
        if bits < 2048:
            fail(f"ssh_keys: {kind} {data[:12]}... is {bits} bits; use 2048 or more (or ed25519)")
    return k


def load(path):
    with open(path) as f:
        cfg = yaml.safe_load(f) or {}
    if not isinstance(cfg, dict):
        fail("config must be a YAML mapping")
    unknown = set(cfg) - KEYS
    if unknown:
        fail(f"unknown keys: {', '.join(sorted(unknown))}")
    if cfg.get("image", "juniper") not in ("juniper", "juniper-minimal", "juniper-desktop"):
        fail("image must be juniper, juniper-minimal or juniper-desktop")
    if "password" in cfg and cfg["password"] != "prompt":
        fail("password: plain-text passwords aren't allowed here; use `password: prompt` "
             "(just flash asks for it and stores only a hash)")
    # Only when asked for: a stray exported variable must not add a password to a headless card.
    wants_pw = cfg.get("image") == "juniper-desktop" or cfg.get("password") == "prompt"
    pw_hash = os.environ.get("JUNIPER_PASSWORD_HASH") if wants_pw else None
    if pw_hash is not None and not re.fullmatch(r"\$6\$[./A-Za-z0-9]{1,16}\$[./A-Za-z0-9]{86}", pw_hash):
        fail("JUNIPER_PASSWORD_HASH must be a SHA-512 crypt hash ($6$...)")
    if cfg.get("image") == "juniper-desktop" and not pw_hash:
        fail("juniper-desktop needs a password: it starts at a login prompt (just flash asks for one)")

    user = cfg.get("user")
    if not isinstance(user, str) or not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", user):
        fail("user: a lowercase login name is required")
    host = str(cfg.get("hostname", "juniper"))
    if not re.fullmatch(r"[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?", host):
        fail("hostname: letters, digits and inner hyphens only")
    keys = cfg.get("ssh_keys")
    if not keys or not isinstance(keys, list):
        fail("ssh_keys: at least one public key is required (password login is off)")
    keys = [ssh_key(k) for k in keys]

    encrypt = cfg.get("encrypt", False)  # opt-in; Task 14 flips the default
    if not isinstance(encrypt, bool):
        fail("encrypt: true or false")
    recovery_key = cfg.get("recovery_key")
    if recovery_key is not None:
        recovery_key = str(recovery_key)
        if recovery_key.startswith("AGE-SECRET-KEY-1"):
            fail("recovery_key: that's an age private key; use its public key (age1...)")
        if not re.fullmatch(r"age1[02-9ac-hj-np-z]{58}", recovery_key):
            fail("recovery_key: expected an age public key (age1 followed by 58 characters)")
        if not bech32_ok("age", recovery_key):
            fail("recovery_key: checksum doesn't match; a character is mistyped (copy it again "
                 "from age-keygen's output)")
    # age can't encrypt to ecdsa or FIDO (sk-) SSH keys, only ssh-ed25519 and ssh-rsa.
    recipients = [recovery_key] if recovery_key else [
        k for k in keys if k.startswith(("ssh-ed25519 ", "ssh-rsa "))]
    if encrypt and not recipients:
        fail("encrypt: no recovery recipient: age can't encrypt to ecdsa or FIDO (sk-) SSH keys; "
             "add an ssh-ed25519 or ssh-rsa key to ssh_keys, or set recovery_key: age1...")

    ts = cfg.get("tailscale_authkey")
    if "tailscale_authkey_file" in cfg:
        kf = os.path.join(os.path.dirname(os.path.abspath(path)),
                          os.path.expanduser(cfg["tailscale_authkey_file"]))
        with open(kf) as f:
            ts = f.read().strip()
    if ts is not None and not str(ts).startswith("tskey-auth-"):
        fail("tailscale_authkey: expected a tskey-auth-... auth key")

    wifi = cfg.get("wifi")
    if wifi is not None:
        if not isinstance(wifi, dict) or not wifi.get("ssid"):
            fail("wifi: ssid is required")
        unknown = set(wifi) - WIFI_KEYS
        if unknown:
            fail(f"wifi: unknown keys: {', '.join(sorted(unknown))}")
        if wifi.get("country") is not None:
            wifi = dict(wifi, country=country_code(wifi["country"]))
    return (host, user, keys, cfg.get("timezone"), ts, wifi, pw_hash,
            encrypt, recipients)


def country_code(value):
    """The Wi-Fi regulatory domain: an ISO 3166-1 alpha-2 code. The image writes it into a
    root-owned modprobe config, so nothing else may get through."""
    if isinstance(value, bool):  # YAML 1.1: unquoted NO (Norway) is false, ON is true
        fail('wifi: country: quote the code, e.g. country: "NO" (YAML reads NO as false)')
    # isascii() first: "ß".upper() is "SS" and "ﬀ".upper() is "FF", not codes anyone typed.
    code = value.upper() if isinstance(value, str) and value.isascii() else None
    if code is None or not re.fullmatch(r"[A-Z]{2}", code):
        fail(f"wifi: country must be a two-letter ISO 3166-1 code such as GB, got {value!r}")
    return code


def write_private(path, data):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(data)
    os.chmod(path, 0o600)


def write_public(path, data):
    """Not secret (an opt-in marker, public recipients); the image reads them from CIDATA."""
    with open(path, "w") as f:
        f.write(data)
    os.chmod(path, 0o644)


def dump(data):
    return yaml.safe_dump(data, sort_keys=False, default_flow_style=False, allow_unicode=True,
                          width=4096)


def main():
    if len(sys.argv) != 3:
        fail("usage: render-cidata CONFIG OUTDIR")
    config, out = sys.argv[1:]
    if os.stat(config).st_mode & 0o077:
        print(f"render-cidata: warning: {config} is readable by others; chmod 600 it",
              file=sys.stderr)
    host, user, keys, tz, ts, wifi, pw_hash, encrypt, recipients = load(config)

    ud = {
        "hostname": host,
        "users": [{
            "name": user,
            "groups": ["wheel"],
            # With a password, sudo asks for it (owner decision); key-only accounts can't answer.
            "sudo": ["ALL=(ALL) ALL" if pw_hash else "ALL=(ALL) NOPASSWD:ALL"],
            "ssh_authorized_keys": keys,
        }],
    }
    if pw_hash:
        ud["users"][0]["passwd"] = pw_hash
        ud["users"][0]["lock_passwd"] = False
    if tz:
        ud["timezone"] = str(tz)
    if ts:
        ud["write_files"] = [{"path": "/etc/tailscale/authkey", "permissions": "0600",
                              "content": str(ts)}]

    os.makedirs(out, mode=0o700, exist_ok=True)
    write_private(os.path.join(out, "user-data"), "#cloud-config\n" + dump(ud))
    write_public(os.path.join(out, "juniper-encrypt"), "on\n" if encrypt else "off\n")
    rec_path = os.path.join(out, "juniper-recovery.txt")
    if encrypt:
        write_public(rec_path, "".join(r + "\n" for r in recipients))
    elif os.path.exists(rec_path):
        os.remove(rec_path)
    nc_path = os.path.join(out, "network-config")
    if wifi:
        ap = {"password": str(wifi["password"])} if wifi.get("password") is not None else {}
        wlan = {"dhcp4": True, "optional": True}
        if wifi.get("country"):
            wlan["regulatory-domain"] = wifi["country"]
        wlan["access-points"] = {str(wifi["ssid"]): ap}
        write_private(nc_path, dump({"network": {"version": 2, "wifis": {"wlan0": wlan}}}))
    elif os.path.exists(nc_path):
        os.remove(nc_path)


if __name__ == "__main__":
    main()
